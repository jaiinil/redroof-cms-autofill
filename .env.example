# RediStay reference API subscription key
REDISTAY_SUBSCRIPTION_KEY=

# CMS write API (UpdateMiblockRecordAsset) - PRODUCTION
# Extract CMS_BEARER_TOKEN from the `mscmswt` cookie and CMS_SESSION_COOKIE
# from `ASP.NET_SessionId` after logging into the CMS admin panel. Expires ~24h.
CMS_WRITE_BASE_URL=https://redroof.cms.milestoneinternet.info
CMS_BEARER_TOKEN=
CMS_CLIENT_APP=ProgrammingApp
CMS_SESSION_COOKIE=
